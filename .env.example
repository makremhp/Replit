# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Telegram BotFather token used only for server-side WebApp initData verification
BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600

# Secret used by the ad provider webhook to verify completed ads
AD_PROVIDER_WEBHOOK_SECRET=

# Required only for the protected server-side ad configuration endpoint
ADMIN_SETTINGS_TOKEN=

# Production DATABASE_URL is managed as a sensitive Vercel variable from Neon.
