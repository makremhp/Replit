# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false only if your provider does not require SSL
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# Telegram BotFather token (store as a secret, never commit the real value)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Comma-separated Telegram numeric user IDs allowed to review withdrawals
TELEGRAM_ADMIN_IDS=

# Optional button shown inside Telegram
PUBLIC_APP_URL=
MIN_WITHDRAWAL=0.01
